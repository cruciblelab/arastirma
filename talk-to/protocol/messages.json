{
 "protocol": "1.0",
 "messages": {
  "probe": {
   "from": "phone",
   "section": "discovery",
   "fields": {
    "talkto": "int"
   },
   "doc": "UDP broadcast to 47601: looking for computers"
  },
  "announce": {
   "from": "pc",
   "section": "discovery",
   "fields": {
    "talkto": "int",
    "app": "enum:talk-to-android",
    "id": "str",
    "name": "str",
    "port": "int",
    "fp": "hex:64",
    "password": "bool"
   },
   "doc": "UDP answer and broadcast every 3 s"
  },
  "hello": {
   "from": "both",
   "section": "handshake",
   "fields": {
    "proto": "int",
    "device_id": "str",
    "name": "str",
    "model": "str?",
    "platform": "enum:android|linux",
    "app": "enum:talk-to-linux|talk-to-android",
    "token": "hex:64|null?",
    "features": "list",
    "commit": "hex:64?",
    "qr": "bool?",
    "version": "str?"
   },
   "doc": "first message of each side (section 4)"
  },
  "auth_required": {
   "from": "pc",
   "section": "handshake",
   "fields": {
    "method": "enum:qr|password|approval",
    "nonce": "hex:32",
    "pair": "int?"
   },
   "doc": "section 4"
  },
  "auth_qr": {
   "from": "phone",
   "section": "handshake",
   "fields": {
    "proof": "hex:64"
   },
   "doc": "section 4"
  },
  "auth_password": {
   "from": "phone",
   "section": "handshake",
   "fields": {
    "proof": "hex:64"
   },
   "doc": "section 4"
  },
  "pair_reveal": {
   "from": "phone",
   "section": "handshake",
   "fields": {
    "secret": "hex:64"
   },
   "doc": "section 4"
  },
  "welcome": {
   "from": "pc",
   "section": "handshake",
   "fields": {
    "token": "hex:64?"
   },
   "doc": "authenticated; `token` only for a new pairing"
  },
  "auth_failed": {
   "from": "pc",
   "section": "handshake",
   "fields": {
    "reason": "enum:wrong_password|rejected|qr_expired|wrong_qr|too_many_attempts|protocol"
   },
   "doc": "then the connection closes"
  },
  "ping": {
   "from": "both",
   "section": "messages",
   "fields": {},
   "doc": "every 15 s; 50 s of silence = lost"
  },
  "pong": {
   "from": "both",
   "section": "messages",
   "fields": {},
   "doc": "answer to `ping` (MAY be ignored)"
  },
  "bye": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "reason": "enum:disconnected|forgotten"
   },
   "doc": "the computer closes; the phone does not reconnect by itself, and on `forgotten` deletes its token"
  },
  "battery": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "level": "int:0..100",
    "charging": "bool"
   },
   "doc": "on change"
  },
  "phone_status": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "flavor": "enum:full|play|lite",
    "sdk": "int",
    "notif_access": "bool",
    "listener": "bool",
    "player": "str|null",
    "notifications_sent": "int",
    "version": "str"
   },
   "doc": "app state, so the computer can explain why notifications or music don't arrive; on connect and on change. `lite` has no notification access, `play` has no overlay permission"
  },
  "phone_info": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "manufacturer": "str",
    "model": "str",
    "android": "str",
    "sdk": "int",
    "security_patch": "str",
    "fingerprint": "str?",
    "app_version": "str",
    "uptime_s": "int",
    "battery": "obj?",
    "storage": "obj?",
    "ram": "obj?",
    "network": "enum:none|wifi|cellular|ethernet|other?"
   },
   "doc": "on connect and on `phone_info_request`. `battery` {level, charging, temp_c, health: good/overheat/dead/over_voltage/cold/null}, `storage` and `ram` {total, free} bytes. No personal data"
  },
  "phone_info_request": {
   "from": "pc",
   "section": "messages",
   "fields": {},
   "doc": "ask for `phone_info`"
  },
  "crash_report": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "text": "str"
   },
   "doc": "stack trace of the last crash (≤ 20 000 chars), once after connecting"
  },
  "notification": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "key": "str",
    "package": "str",
    "app": "str",
    "title": "str",
    "text": "str",
    "time_ms": "int"
   },
   "doc": "a phone notification (not ongoing ones)"
  },
  "notification_removed": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "key": "str"
   },
   "doc": "removed on the phone"
  },
  "app_icon": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "package": "str",
    "data": "b64"
   },
   "doc": "PNG icon, once per app and connection"
  },
  "call": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "key": "str",
    "package": "str",
    "app": "str",
    "caller": "str",
    "text": "str",
    "state": "enum:ringing|ongoing",
    "actions": "list:{i:int,title:str}"
   },
   "doc": "a call (phone, WhatsApp, …) with the app's own buttons; sent again on change"
  },
  "call_ended": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "key": "str"
   },
   "doc": "the call notification is gone"
  },
  "call_action": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "key": "str",
    "action": "int"
   },
   "doc": "press button `i` of `call.actions`"
  },
  "call_volume": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "dir": "int:-1..1"
   },
   "doc": "call volume one step up (1) or down (-1)"
  },
  "call_result": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "kind": "enum:action|volume",
    "title": "str|null?",
    "error": "str|null?",
    "before": "int?",
    "after": "int?",
    "max": "int?",
    "mode": "enum:in_call|in_communication|ringtone|normal?"
   },
   "doc": "what `call_action` or `call_volume` did (for diagnosis)"
  },
  "media_state": {
   "from": "both",
   "section": "messages",
   "fields": {
    "active": "bool",
    "player": "str?",
    "title": "str?",
    "artist": "str?",
    "album": "str?",
    "playing": "bool?",
    "position_ms": "int?",
    "duration_ms": "int?",
    "volume": "int:0..100|null?",
    "can_seek": "bool?",
    "art_id": "hex:16|null?"
   },
   "doc": "what is playing on the sender; `{active:false}` when nothing"
  },
  "media_art": {
   "from": "both",
   "section": "messages",
   "fields": {
    "art_id": "hex:16",
    "mime": "enum:image/jpeg|image/png",
    "data": "b64"
   },
   "doc": "cover image, only when `art_id` changes"
  },
  "media_control": {
   "from": "both",
   "section": "messages",
   "fields": {
    "action": "enum:play_pause|play|pause|next|previous|seek|volume",
    "value": "int|null"
   },
   "doc": "to the owner of the player; `value`: ms for seek, 0–100 for volume, else null"
  },
  "clipboard": {
   "from": "both",
   "section": "messages",
   "fields": {
    "text": "str"
   },
   "doc": "≤ 1 000 000 chars (the phone keeps ≤ 100 000)"
  },
  "open_url": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "url": "str"
   },
   "doc": "open in the computer's browser; http/https only"
  },
  "ring": {
   "from": "pc",
   "section": "messages",
   "fields": {},
   "doc": "find my phone: ring even when silent, 30 s"
  },
  "ring_stop": {
   "from": "pc",
   "section": "messages",
   "fields": {},
   "doc": "stop ringing"
  },
  "timer": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "seconds": "int",
    "label": "str"
   },
   "doc": "countdown on the phone (seconds > 0, label ≤ 80 chars)"
  },
  "timer_cancel": {
   "from": "pc",
   "section": "messages",
   "fields": {},
   "doc": "cancel the timer"
  },
  "notify": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "title": "str",
    "text": "str"
   },
   "doc": "show a notification on the phone"
  },
  "profile": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "id": "str",
    "name": "str",
    "permissions": "obj",
    "vibrate": "bool"
   },
   "doc": "what this phone may do; on connect and on change. `permissions`: notifications, media, files, clipboard, open_url, commands, power, screenshot (bool)"
  },
  "commands": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "items": "list:{id:str,name:str,icon:str,power:bool}"
   },
   "doc": "commands the profile allows; `id` is opaque, `icon` lock/sleep/restart/power/terminal"
  },
  "run_command": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "id": "str"
   },
   "doc": "run a listed command (the command text never travels)"
  },
  "command_result": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "id": "str",
    "name": "str?",
    "ok": "bool",
    "code": "int?",
    "output": "str"
   },
   "doc": "`output`: last 8000 chars, human-readable"
  },
  "sysinfo_request": {
   "from": "phone",
   "section": "messages",
   "fields": {},
   "doc": "ask for `sysinfo`"
  },
  "sysinfo": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "host": "str",
    "os": "str",
    "cpu": "num|null",
    "cores": "int",
    "load": "num",
    "mem_used": "int",
    "mem_total": "int",
    "disk_used": "int",
    "disk_total": "int",
    "battery": "obj|null",
    "uptime": "int",
    "time": "int",
    "volume": "int|null",
    "muted": "bool"
   },
   "doc": "computer state; also the answer to `pc_volume`. `uptime`, `time` in seconds, `battery` {level, charging}"
  },
  "pc_volume": {
   "from": "phone",
   "section": "messages",
   "fields": {
    "value": "int:0..100|null",
    "toggle_mute": "bool"
   },
   "doc": "set the computer's volume"
  },
  "setup_request": {
   "from": "phone",
   "section": "messages",
   "fields": {},
   "doc": "USB only: the computer grants this app's permissions over adb"
  },
  "setup_result": {
   "from": "pc",
   "section": "messages",
   "fields": {
    "items": "list:{key:str,title:str,ok:bool|null,message:str}",
    "summary": "str"
   },
   "doc": "result per step (`ok` null: not needed); texts are human-readable"
  },
  "screenshot_request": {
   "from": "phone",
   "section": "messages",
   "fields": {},
   "doc": "the computer sends a screenshot with `file_offer`"
  },
  "file_offer": {
   "from": "both",
   "section": "messages",
   "fields": {
    "transfer_id": "int",
    "name": "str",
    "size": "int",
    "mime": "str"
   },
   "doc": "section 7"
  },
  "file_accept": {
   "from": "both",
   "section": "messages",
   "fields": {
    "transfer_id": "int"
   },
   "doc": "section 7"
  },
  "file_reject": {
   "from": "both",
   "section": "messages",
   "fields": {
    "transfer_id": "int",
    "reason": "str?"
   },
   "doc": "section 7; `reason` human-readable"
  },
  "file_done": {
   "from": "both",
   "section": "messages",
   "fields": {
    "transfer_id": "int",
    "sha256": "hex:64"
   },
   "doc": "all binary frames sent"
  },
  "file_result": {
   "from": "both",
   "section": "messages",
   "fields": {
    "transfer_id": "int",
    "ok": "bool",
    "reason": "str?"
   },
   "doc": "the receiver's verdict"
  },
  "file_cancel": {
   "from": "both",
   "section": "messages",
   "fields": {
    "transfer_id": "int",
    "direction": "enum:in|out",
    "reason": "str?"
   },
   "doc": "`in`: a transfer to the receiver of this message, `out`: one it sends (both sides count from 1)"
  }
 }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Yalnızca "tam" sürüm: bildirim erişimi (bildirimleri bilgisayara iletmek ve telefondaki medyayı
     bilgisayardan kontrol etmek için). "hafif" sürümde bu servis yoktur. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Aramayı bilgisayardan cevaplamak: bazı telefonlarda (HyperOS) arama uygulamasının "Cevapla" düğmesi
         başka uygulamadan basılınca çalışmıyor; Android'in resmi yolu (TelecomManager.acceptRingingCall). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- "Cevapla" arama ekranını açar; Android arka plandan ekran açmayı engelliyor. Bu izinle telefon
         basarken bir anlığına görünmez bir nokta gösterir ve engele takılmaz. Bilgisayar USB'den verir. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application>

        <service
            android:name=".service.NotificationListener"
            android:exported="true"
            android:label="Talk To"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
